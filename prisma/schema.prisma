// Club Event Ops (COOK) — M1 data model
// Local dev uses SQLite via Prisma. See README for Supabase/Postgres migration notes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  partners Partner[]
  events   Event[]
  drafts   Draft[]
  metrics  Metric[]
}

enum MemberRole {
  OWNER
  OFFICER
  MEMBER
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  email       String
  name        String
  role        MemberRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

model Partner {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  org         String?
  notes       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  Contact[]
}

model Contact {
  id        String  @id @default(cuid())
  partnerId String
  name      String
  email     String?
  phone     String?
  role      String?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

enum EventStatus {
  PLANNING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Event {
  id          String      @id @default(cuid())
  workspaceId String
  title       String
  brief       String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  status      EventStatus @default(PLANNING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]
  runOfShow RunOfShowItem[]
  drafts    Draft[]
  metrics   Metric[]
  followUps FollowUp[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(cuid())
  eventId     String
  title       String
  description String?
  assignee    String?
  dueAt       DateTime?
  status      TaskStatus @default(TODO)
  sortOrder   Int        @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model RunOfShowItem {
  id          String  @id @default(cuid())
  eventId     String
  time        String
  durationMin Int?
  title       String
  notes       String?
  sortOrder   Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum DraftChannel {
  EMAIL
  SLACK
}

enum DraftStatus {
  DRAFT
  AWAITING_APPROVAL
  SENT
  REJECTED
}

model Draft {
  id          String       @id @default(cuid())
  workspaceId String
  eventId     String?
  channel     DraftChannel
  subject     String?
  body        String
  status      DraftStatus  @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model Metric {
  id          String   @id @default(cuid())
  workspaceId String
  eventId     String?
  name        String
  value       Float?
  unit        String?
  notes       String?
  recordedAt  DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  followUps FollowUp[]
}

model FollowUp {
  id        String    @id @default(cuid())
  eventId   String
  metricId  String?
  title     String
  notes     String?
  dueAt     DateTime?
  completed Boolean   @default(false)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  metric Metric? @relation(fields: [metricId], references: [id], onDelete: SetNull)
}
