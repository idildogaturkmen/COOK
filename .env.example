# SQLite database for local development (default)
DATABASE_URL="file:./dev.db"

# Auth stub — set to "true" to bypass real auth in development
COOK_AUTH_BYPASS="true"

# Optional: pin active workspace when multiple exist (defaults to first workspace)
# COOK_WORKSPACE_ID=""

