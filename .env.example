# SQLite database for local development (default)
DATABASE_URL="file:./dev.db"

# Auth stub — set to "true" to bypass real auth in development
COOK_AUTH_BYPASS="true"

# Optional: pin active workspace when multiple exist (defaults to first workspace)
# COOK_WORKSPACE_ID=""

# Future: Supabase (not required for M1 local CRUD)
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Future: real LLM provider for /api/ai
# Skill handlers (ops, outreach, metrics/AFTERS) are deterministic by default and
# need no key. Set both of these to take the LLM branch in src/lib/ai/provider.ts.
# COOK_AI_PROVIDER="openai"
# OPENAI_API_KEY=""
